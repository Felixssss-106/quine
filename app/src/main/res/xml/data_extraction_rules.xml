<?xml version="1.0" encoding="utf-8"?>
<!--
  安全清单（agent-prompt.md §2.7）：对话内容、设置、Key 密文一律不出设备。
  Android 12+ 的「设备间直传」不受 allowBackup=false 约束，必须在此显式排除。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
